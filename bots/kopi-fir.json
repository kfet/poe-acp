{
  "name": "kopi-fir",
  "host": "ko1",
  "platform": "linux/arm64",
  "supervisor": "systemd-user",
  "unit": "poe-acp-kopi-fir",
  "binary": "~/.local/bin/poe-acp",
  "agent": { "cmd": "fir --mode acp", "kind": "fir" },
  "fir": { "exts": ["github.com/kfet/fir-exts"] },
  "server": {
    "http_addr": "127.0.0.1:8347",
    "poe_path": "/kopi-fir",
    "config_path": "~/.config/poe-acp/bot-kopi-fir/config.json",
    "heartbeat_interval": "3s",
    "session_ttl": "10m",
    "enable_mcp_attach": true,
    "introduction": "kopi-fir — fir over ACP on kopione (arm64). Send !help (!login, !model, !status, !new). Any provider; default opus-4-8."
  },
  "systemd": {
    "env_path": "%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
  },
  "config": {
    "bot_name": "kopi-fir",
    "defaults": {
      "model": "anthropic/claude-opus-5",
      "thinking": "medium",
      "hide_thinking": false,
      "coalesce_ms": 3000,
      "coalesce_grid": true,
      "spinner_animate": false
    }
  },
  "credentials": { "env_file": "~/.config/poe-acp/bot-kopi-fir/env" }
}
