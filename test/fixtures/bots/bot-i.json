{
  "name": "bot-i",
  "host": "host-e",
  "platform": "linux/amd64",
  "supervisor": "systemd-user",
  "unit": "poe-acp-bot-i",
  "binary": "~/.local/bin/poe-acp",
  "agent": {
    "cmd": "ssh -T -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4 host-a .local/bin/acp-tmux -config .config/acp-tmux/config.json -agent fir",
    "kind": "acp-tmux"
  },
  "server": {
    "http_addr": "127.0.0.1:8348",
    "poe_path": "/acp-tmux",
    "config_path": "~/.config/poe-acp/bot-i/config.json",
    "heartbeat_interval": "3s",
    "session_ttl": "30m",
    "introduction": "acp-tmux — drives real terminal coding agents (codex, claude-code, aider, crush, gemini-cli, opencode) in tmux panes on host-a, fronted as ACP. Turn boundaries via ACPEND markers."
  },
  "systemd": {
    "env_path": "%h/.local/bin:/usr/local/bin:/usr/bin:/bin",
    "restart": "on-failure",
    "restart_sec": "2s"
  },
  "config": {
    "bot_name": "bot-l",
    "hosts": [
      {
        "value": "local",
        "name": "host-a (local)"
      },
      {
        "value": "host-b"
      },
      {
        "value": "host-c"
      },
      {
        "value": "host-e"
      },
      {
        "value": "host-g",
        "name": "air m1"
      }
    ],
    "defaults": {
      "model": "fir",
      "thinking": "medium",
      "host": "local"
    }
  },
  "credentials": {
    "env_file": "~/.config/poe-acp/bot-i/env"
  },
  "relay": "poe-acp",
  "state": "active",
  "source": {
    "deploy_skill": "poe-acp: scripts/converge.sh",
    "repo": "github.com/kfet/poe-acp"
  }
}
