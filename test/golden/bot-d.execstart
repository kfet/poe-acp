%h/.local/bin/poe-acp --http-addr 127.0.0.1:8347 --poe-path /bot-d --config %h/.config/poe-acp/bot-bot-d/config.json --agent-cmd "fir --mode acp" --heartbeat-interval 3s --session-ttl 10m --enable-mcp-attach --introduction "bot-d — fir over ACP on host-d (arm64). Send !help (!login, !model, !status, !new). Any provider; default opus-5."
