%h/.local/bin/poe-acp --http-addr 127.0.0.1:8348 --poe-path /acp-tmux --config %h/.config/poe-acp/bot-i/config.json --agent-cmd "ssh -T -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4 host-a .local/bin/acp-tmux -config .config/acp-tmux/config.json -agent fir" --heartbeat-interval 3s --session-ttl 30m --introduction "acp-tmux — drives real terminal coding agents (codex, claude-code, aider, crush, gemini-cli, opencode) in tmux panes on host-a, fronted as ACP. Turn boundaries via ACPEND markers."
