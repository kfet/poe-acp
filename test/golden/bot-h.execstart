%h/.local/bin/poe-acp --http-addr 127.0.0.1:8350 --poe-path /bot-h --config %h/.config/poe-acp/bot-h/config.json --agent-cmd "ssh -T -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=4 host-b .local/bin/fir --mode acp" --heartbeat-interval 3s --session-ttl 10m --introduction "bot-h — fir on host-b, reached over plain ssh. Probe bot for the ACP-over-ssh transport question."
