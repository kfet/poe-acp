%h/.local/bin/poe-acp --http-addr 127.0.0.1:8347 --poe-path /sea-fir --config %h/.config/poe-acp/bot-sea-fir/config.json --agent-cmd "fir --mode acp" --heartbeat-interval 3s --session-ttl 10m --introduction "sea-fir — fir over ACP on sea-racknerd. Send !help for commands (!login, !model, !status, !new). Any provider; default opus-4-8/low."
